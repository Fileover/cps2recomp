<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher runs in the app's own process. Each game runs in a process of its own: its library (lib<id>.so)
     keeps its state in globals, as the program does on a computer, so the process ends with the game
     (GameActivity.java). The launcher takes the next of the four slots each time, so that a game started straight
     after another (the Multi game page) never lands in a process that is still ending. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:isGame="true"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="false"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true">
        <!-- The back button reaches the launcher and the games (Back, the game's menu) instead of closing them. -->
        <meta-data android:name="SDL_ENV.SDL_ANDROID_TRAP_BACK_BUTTON" android:value="1" />
        <!-- Landscape, either way up: SDL otherwise lets a resizable window turn with the phone -->
        <meta-data android:name="SDL_ENV.SDL_ORIENTATIONS" android:value="LandscapeLeft LandscapeRight" />
        <activity
            android:name=".LauncherActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".GameActivity$Slot0" android:process=":game0"
            android:screenOrientation="sensorLandscape" android:preferMinimalPostProcessing="true" android:exported="false"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <activity android:name=".GameActivity$Slot1" android:process=":game1"
            android:screenOrientation="sensorLandscape" android:preferMinimalPostProcessing="true" android:exported="false"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <activity android:name=".GameActivity$Slot2" android:process=":game2"
            android:screenOrientation="sensorLandscape" android:preferMinimalPostProcessing="true" android:exported="false"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <activity android:name=".GameActivity$Slot3" android:process=":game3"
            android:screenOrientation="sensorLandscape" android:preferMinimalPostProcessing="true" android:exported="false"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />
    </application>
</manifest>
