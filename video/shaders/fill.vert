// A triangle over the whole target (the picture's first and third passes: a pixel at a time)
void main() {
    const vec2 at = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
    gl_Position = vec4(at * 2.0 - 1.0, 0.0, 1.0);
}
